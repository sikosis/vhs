#compdef vhs

_arguments \
  '(-h --help)'{-h,--help}'[show help]' \
  '(-v --version)'{-v,--version}'[show version]' \
  '1:command or tape:->command' \
  '*:argument:->argument'

case $state in
  command)
    _alternative \
      'commands:command:(new check manual record version help)' \
      'tapes:tape file:_files -g "*.tape"'
    ;;
  argument)
    case $words[2] in
      new|check) _files ;;
    esac
    ;;
esac
